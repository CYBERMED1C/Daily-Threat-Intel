/* ===== BEGIN CYBERMEDIC Elastic url destination.ip host-pivot 003 ===== */
/* Business date: 2026-09-24; lookback: 30 days; run this block separately. */
/* URL note: Elastic Defend network telemetry is hunted by the URL host; confirm the full path in available proxy or web telemetry. */
FROM logs-endpoint.events.network-* METADATA _index
| WHERE @timestamp >= NOW() - 30 days
| WHERE destination.ip IN ("45.150.33.128")
| EVAL MatchedValue = TO_STRING(destination.ip)
| STATS FirstSeen = MIN(@timestamp), LastSeen = MAX(@timestamp), HitCount = COUNT(*) BY MatchedValue, host.name, _index
| RENAME host.name AS DeviceName, _index AS ElasticHitSource
| EVAL IOC = CASE(MatchedValue == "45.150.33.128", "http://45.150.33.128/92961f75b259df2?force=1", "")
| EVAL IOCType = "url", MatchedField = "destination.ip"
| EVAL ThreatName = CASE(MatchedValue == "45.150.33.128", "Macfinger ClickFix campaign", "")
| EVAL ThreatActor = CASE(MatchedValue == "45.150.33.128", "", "")
| EVAL Confidence = CASE(MatchedValue == "45.150.33.128", "99", "")::INTEGER
| EVAL IntelSource = CASE(MatchedValue == "45.150.33.128", "SANS Internet Storm Center", "")
| EVAL SourceURL = CASE(MatchedValue == "45.150.33.128", "https://isc.sans.edu/diary.html?storyid=33360", "")
| KEEP IOC, IOCType, MatchedValue, MatchedField, DeviceName, FirstSeen, LastSeen, HitCount, ElasticHitSource, ThreatName, ThreatActor, Confidence, IntelSource, SourceURL
| SORT LastSeen DESC
| LIMIT 1000
