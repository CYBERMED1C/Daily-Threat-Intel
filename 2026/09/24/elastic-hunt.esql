/* CYBERMEDIC ELASTIC ES|QL THREAT HUNTING */
/* Run one named query block at a time. No external lookup is required. */
/* Schema reference: https://www.elastic.co/docs/reference/integrations/endpoint */
/* ===== BEGIN CYBERMEDIC Elastic domain destination.domain batch 001 ===== */
/* Business date: 2026-09-24; lookback: 30 days; run this block separately. */
FROM logs-endpoint.events.network-* METADATA _index
| WHERE @timestamp >= NOW() - 30 days
| WHERE destination.domain IN ("cdn.sendibt1.com", "cdn10.sendibt1.com", "cdn11.sendibt1.com", "cdn2.sendibt1.com", "cdn3.sendibt1.com", "cdn4.sendibt1.com", "cdn9.sendibt1.com", "corralos.beer", "docusign.web-viewww.es", "glegchner.com")
| EVAL MatchedValue = TO_STRING(destination.domain)
| STATS FirstSeen = MIN(@timestamp), LastSeen = MAX(@timestamp), HitCount = COUNT(*) BY MatchedValue, host.name, _index
| RENAME host.name AS DeviceName, _index AS ElasticHitSource
| EVAL IOC = CASE(MatchedValue == "cdn.sendibt1.com", "cdn.sendibt1.com", MatchedValue == "cdn10.sendibt1.com", "cdn10.sendibt1.com", MatchedValue == "cdn11.sendibt1.com", "cdn11.sendibt1.com", MatchedValue == "cdn2.sendibt1.com", "cdn2.sendibt1.com", MatchedValue == "cdn3.sendibt1.com", "cdn3.sendibt1.com", MatchedValue == "cdn4.sendibt1.com", "cdn4.sendibt1.com", MatchedValue == "cdn9.sendibt1.com", "cdn9.sendibt1.com", MatchedValue == "corralos.beer", "corralos.beer", MatchedValue == "docusign.web-viewww.es", "docusign.web-viewww.es", MatchedValue == "glegchner.com", "glegchner.com", "")
| EVAL IOCType = "domain", MatchedField = "destination.domain"
| EVAL ThreatName = CASE(MatchedValue == "cdn.sendibt1.com", "Brevo supply-chain ClickFix compromise", MatchedValue == "cdn10.sendibt1.com", "Brevo supply-chain ClickFix compromise", MatchedValue == "cdn11.sendibt1.com", "Brevo supply-chain ClickFix compromise", MatchedValue == "cdn2.sendibt1.com", "Brevo supply-chain ClickFix compromise", MatchedValue == "cdn3.sendibt1.com", "Brevo supply-chain ClickFix compromise", MatchedValue == "cdn4.sendibt1.com", "Brevo supply-chain ClickFix compromise", MatchedValue == "cdn9.sendibt1.com", "Brevo supply-chain ClickFix compromise", MatchedValue == "corralos.beer", "Brevo supply-chain ClickFix compromise", MatchedValue == "docusign.web-viewww.es", "CSuite device-code phishing campaign", MatchedValue == "glegchner.com", "Brevo supply-chain ClickFix compromise", "")
| EVAL ThreatActor = CASE(MatchedValue == "cdn.sendibt1.com", "", MatchedValue == "cdn10.sendibt1.com", "", MatchedValue == "cdn11.sendibt1.com", "", MatchedValue == "cdn2.sendibt1.com", "", MatchedValue == "cdn3.sendibt1.com", "", MatchedValue == "cdn4.sendibt1.com", "", MatchedValue == "cdn9.sendibt1.com", "", MatchedValue == "corralos.beer", "", MatchedValue == "docusign.web-viewww.es", "CSuite", MatchedValue == "glegchner.com", "", "")
| EVAL Confidence = CASE(MatchedValue == "cdn.sendibt1.com", "95", MatchedValue == "cdn10.sendibt1.com", "97", MatchedValue == "cdn11.sendibt1.com", "95", MatchedValue == "cdn2.sendibt1.com", "95", MatchedValue == "cdn3.sendibt1.com", "95", MatchedValue == "cdn4.sendibt1.com", "95", MatchedValue == "cdn9.sendibt1.com", "95", MatchedValue == "corralos.beer", "97", MatchedValue == "docusign.web-viewww.es", "92", MatchedValue == "glegchner.com", "97", "")::INTEGER
| EVAL IntelSource = CASE(MatchedValue == "cdn.sendibt1.com", "F5 Labs", MatchedValue == "cdn10.sendibt1.com", "F5 Labs", MatchedValue == "cdn11.sendibt1.com", "F5 Labs", MatchedValue == "cdn2.sendibt1.com", "F5 Labs", MatchedValue == "cdn3.sendibt1.com", "F5 Labs", MatchedValue == "cdn4.sendibt1.com", "F5 Labs", MatchedValue == "cdn9.sendibt1.com", "F5 Labs", MatchedValue == "corralos.beer", "F5 Labs", MatchedValue == "docusign.web-viewww.es", "Gurucul Threat Research", MatchedValue == "glegchner.com", "F5 Labs", "")
| EVAL SourceURL = CASE(MatchedValue == "cdn.sendibt1.com", "https://www.f5.com/labs/articles/weekly-threat-bulletin-september-23rd-2026", MatchedValue == "cdn10.sendibt1.com", "https://www.f5.com/labs/articles/weekly-threat-bulletin-september-23rd-2026", MatchedValue == "cdn11.sendibt1.com", "https://www.f5.com/labs/articles/weekly-threat-bulletin-september-23rd-2026", MatchedValue == "cdn2.sendibt1.com", "https://www.f5.com/labs/articles/weekly-threat-bulletin-september-23rd-2026", MatchedValue == "cdn3.sendibt1.com", "https://www.f5.com/labs/articles/weekly-threat-bulletin-september-23rd-2026", MatchedValue == "cdn4.sendibt1.com", "https://www.f5.com/labs/articles/weekly-threat-bulletin-september-23rd-2026", MatchedValue == "cdn9.sendibt1.com", "https://www.f5.com/labs/articles/weekly-threat-bulletin-september-23rd-2026", MatchedValue == "corralos.beer", "https://www.f5.com/labs/articles/weekly-threat-bulletin-september-23rd-2026", MatchedValue == "docusign.web-viewww.es", "https://partner.gurucul.com/articles/ThreatResearch/CSuite-Targets-US-and-EU-Organizations-23-9-2026", MatchedValue == "glegchner.com", "https://www.f5.com/labs/articles/weekly-threat-bulletin-september-23rd-2026", "")
| KEEP IOC, IOCType, MatchedValue, MatchedField, DeviceName, FirstSeen, LastSeen, HitCount, ElasticHitSource, ThreatName, ThreatActor, Confidence, IntelSource, SourceURL
| SORT LastSeen DESC
| LIMIT 1000
/* ===== END CYBERMEDIC Elastic domain destination.domain batch 001 ===== */
