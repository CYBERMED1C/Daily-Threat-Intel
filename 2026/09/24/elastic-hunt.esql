| EVAL Confidence = CASE(MatchedValue == "cdn.sendibt1.com", "95", MatchedValue == "cdn10.sendibt1.com", "97", MatchedValue == "cdn11.sendibt1.com", "95", MatchedValue == "cdn2.sendibt1.com", "95", MatchedValue == "cdn3.sendibt1.com", "95", MatchedValue == "cdn4.sendibt1.com", "95", MatchedValue == "cdn9.sendibt1.com", "95", MatchedValue == "corralos.beer", "97", MatchedValue == "docusign.web-viewww.es", "92", MatchedValue == "glegchner.com", "97", "")::INTEGER
| EVAL IntelSource = CASE(MatchedValue == "cdn.sendibt1.com", "F5 Labs", MatchedValue == "cdn10.sendibt1.com", "F5 Labs", MatchedValue == "cdn11.sendibt1.com", "F5 Labs", MatchedValue == "cdn2.sendibt1.com", "F5 Labs", MatchedValue == "cdn3.sendibt1.com", "F5 Labs", MatchedValue == "cdn4.sendibt1.com", "F5 Labs", MatchedValue == "cdn9.sendibt1.com", "F5 Labs", MatchedValue == "corralos.beer", "F5 Labs", MatchedValue == "docusign.web-viewww.es", "Gurucul Threat Research", MatchedValue == "glegchner.com", "F5 Labs", "")
