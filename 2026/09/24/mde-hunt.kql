Center","https://isc.sans.edu/diary.html?storyid=33360",99,"NEW","http://45.150.33.128/d4c8083a7d97?force=1","url","Macfinger ClickFix campaign","","SANS Internet Storm Center","https://isc.sans.edu/diary.html?storyid=33360",99,"NEW","https://localcontex.online/AdobecloudReader/pdf_Reader_en_install.msi","url","CSuite device-code phishing campaign","CSuite","Gurucul Threat Research","https://partner.gurucul.com/articles/ThreatResearch/CSuite-Targets-US-and-EU-Organizations-23-9-2026",96,"NEW","https://localcontex.online/review.signal-doc.cloud/.DocuSign/","url","CSuite device-code phishing campaign","CSuite","Gurucul Threat Research","https://partner.gurucul.com/articles/ThreatResearch/CSuite-Targets-US-and-EU-Organizations-23-9-2026",96,"NEW","https://velvet-otter-glagceis.life/ext-b.4f9db6afd06a.js","url","Macfinger ClickFix campaign","","SANS Internet Storm Center","https://isc.sans.edu/diary.html?storyid=33360",98,"NEW","https://velvet-otter-glagceis.life/t.4b1009ff6c3f.js","url","Macfinger ClickFix campaign","","SANS Internet Storm Center","https://isc.sans.edu/diary.html?storyid=33360",98,"NEW"];
union
(
DeviceNetworkEvents
| where Timestamp >= ago(30d)
| where isnotempty(RemoteUrl)
| extend MatchKey=tolower(iif(RemoteUrl startswith "http://" or RemoteUrl startswith "https://", tostring(parse_url(RemoteUrl).Host), trim_end(@"[.]$", RemoteUrl)))
| join kind=inner hint.strategy=broadcast (IOCs | where IOCType == "domain" | extend IntelKey=tolower(IOC)) on $left.MatchKey == $right.IntelKey
| project Timestamp,IOC,IOCType,MatchedField="RemoteUrl",MDEHitSource="DeviceNetworkEvents.RemoteUrl",DeviceName,DeviceId,ActionType,RemoteIP=RemoteIP,RemotePort=tostring(RemotePort),RemoteUrl=RemoteUrl,Protocol=Protocol,FileName="",FolderPath="",SHA256="",SHA1="",MD5="",ProcessCommandLine="",InitiatingProcessFileName,InitiatingProcessCommandLine,ReportId=tostring(ReportId),ThreatName,ThreatActor,Confidence,IntelSource,SourceURL,Status
),
(
DeviceNetworkEvents
| where Timestamp >= ago(30d)
| where isnotempty(RemoteUrl)
| extend MatchKey=tolower(RemoteUrl)
| join kind=inner hint.strategy=broadcast (IOCs | where IOCType == "url" | extend IntelKey=tolower(IOC)) on $left.MatchKey == $right.IntelKey
| project Timestamp,IOC,IOCType,MatchedField="RemoteUrl",MDEHitSource="DeviceNetworkEvents.RemoteUrl",DeviceName,DeviceId,ActionType,RemoteIP=RemoteIP,RemotePort=tostring(RemotePort),RemoteUrl=RemoteUrl,Protocol=Protocol,FileName="",FolderPath="",SHA256="",SHA1="",MD5="",ProcessCommandLine="",InitiatingProcessFileName,InitiatingProcessCommandLine,ReportId=tostring(ReportId),ThreatName,ThreatActor,Confidence,IntelSource,SourceURL,Status
)
| order by Timestamp desc
