// CYBERMEDIC MDE ADVANCED HUNTING - LIGHTWEIGHT
// Run one named query block at a time. Each block uses early exact filters.
// Default lookback: 30 days; result limit: 500.
// Schema reference: https://learn.microsoft.com/en-us/defender-xdr/advanced-hunting-schema-tables
// ===== BEGIN QUERY 001: domain in DeviceNetworkEvents.RemoteUrl =====
// Business date: 2026-09-20; run this query block by itself.
// Source: Cisco Talos - https://blog.talosintelligence.com/clearfake-webdav-infection-chain/
DeviceNetworkEvents
| where Timestamp >= ago(30d)
| where RemoteUrl in~ ("bsc-testnet-rpc.publicnode.com", "bsc.rpc.blxrbdn.com", "fd.gstats-api-contact.cc", "js.downloader", "kffd3.vexlatech.cc", "kffd3.vogueatelier.cc", "lb.propertyfind.cc", "leaguejazire.com", "paternal-angrily.com", "pf.ch", "pkg.vogueatelier.cc", "riyazinikokar.xyz", "static.quorashift.cc", "telegra.ph", "update.dubbedmuch.cc", "verification.google", "win.backdoor", "win.malware")
| extend IOC=RemoteUrl,IOCType="domain",MatchedField="RemoteUrl",MDEHitSource="DeviceNetworkEvents.RemoteUrl",IntelSource="Cisco Talos",SourceURL="https://blog.talosintelligence.com/clearfake-webdav-infection-chain/"
| project Timestamp,DeviceName,ActionType,RemoteIP,RemotePort,RemoteUrl,Protocol,InitiatingProcessFileName,InitiatingProcessCommandLine,IOC,IOCType,MatchedField,MDEHitSource,IntelSource,SourceURL
| take 500
// ===== END QUERY 001 =====
