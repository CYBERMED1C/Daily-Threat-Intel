union
(
DeviceNetworkEvents
| where Timestamp >= ago(30d)
| where isnotempty(RemoteUrl)
| extend MatchKey=tolower(tostring(iif(RemoteUrl startswith "http://" or RemoteUrl startswith "https://", tostring(parse_url(RemoteUrl).Host), trim_end(@"[.]$", RemoteUrl))))
| join kind=inner hint.strategy=broadcast (IOCs | where IOCType == "domain" | extend IntelKey=tolower(IOC)) on $left.MatchKey == $right.IntelKey
| where Timestamp >= ago(EffectiveLookbackDays * 1d)
| project Timestamp,IOC,IOCType,MatchedField="RemoteUrlHost",MDEHitSource="DeviceNetworkEvents",DeviceName=DeviceName,DeviceId=DeviceId,ActionType=ActionType,AccountName=InitiatingProcessAccountName,LocalIP=LocalIP,LocalPort=tostring(LocalPort),RemoteIP=RemoteIP,RemotePort=tostring(RemotePort),RemoteUrl=RemoteUrl,Protocol=Protocol,FileName="",FolderPath="",SHA256="",SHA1="",MD5="",ProcessCommandLine="",InitiatingProcessFileName=InitiatingProcessFileName,InitiatingProcessCommandLine=InitiatingProcessCommandLine,InitiatingProcessAccountName=InitiatingProcessAccountName,InitiatingProcessSHA256=InitiatingProcessSHA256,RegistryKey="",RegistryValueName="",RegistryValueData="",ReportId=tostring(ReportId),ThreatName,ThreatActor,Confidence,IntelSource,SourceArticle,SourceURL,ArticlePublishedDate,RecommendedLookbackDays,RequestedLookbackDays,AvailableLookbackDays,EffectiveLookbackDays,MITRETechnique,SharedInfrastructure,ChangeStatus
),
(
DeviceProcessEvents
| where Timestamp >= ago(30d)
| extend MatchKey=tolower(tostring(FileName))
| join kind=inner hint.strategy=broadcast (IOCs | where IOCType == "file_name" | extend IntelKey=tolower(IOC)) on $left.MatchKey == $right.IntelKey
| where Timestamp >= ago(EffectiveLookbackDays * 1d)
| project Timestamp,IOC,IOCType,MatchedField="FileName",MDEHitSource="DeviceProcessEvents",DeviceName=DeviceName,DeviceId=DeviceId,ActionType=ActionType,AccountName=AccountName,LocalIP="",LocalPort="",RemoteIP="",RemotePort="",RemoteUrl="",Protocol="",FileName=FileName,FolderPath=FolderPath,SHA256=SHA256,SHA1=SHA1,MD5=MD5,ProcessCommandLine=ProcessCommandLine,InitiatingProcessFileName=InitiatingProcessFileName,InitiatingProcessCommandLine=InitiatingProcessCommandLine,InitiatingProcessAccountName=InitiatingProcessAccountName,InitiatingProcessSHA256=InitiatingProcessSHA256,RegistryKey="",RegistryValueName="",RegistryValueData="",ReportId=tostring(ReportId),ThreatName,ThreatActor,Confidence,IntelSource,SourceArticle,SourceURL,ArticlePublishedDate,RecommendedLookbackDays,RequestedLookbackDays,AvailableLookbackDays,EffectiveLookbackDays,MITRETechnique,SharedInfrastructure,ChangeStatus
),
(
DeviceProcessEvents
| where Timestamp >= ago(30d)
| extend MatchKey=tolower(tostring(strcat(FolderPath,"\\",FileName)))
| join kind=inner hint.strategy=broadcast (IOCs | where IOCType == "file_path" | extend IntelKey=tolower(IOC)) on $left.MatchKey == $right.IntelKey
| where Timestamp >= ago(EffectiveLookbackDays * 1d)
| project Timestamp,IOC,IOCType,MatchedField="FolderPath+FileName",MDEHitSource="DeviceProcessEvents",DeviceName=DeviceName,DeviceId=DeviceId,ActionType=ActionType,AccountName=AccountName,LocalIP="",LocalPort="",RemoteIP="",RemotePort="",RemoteUrl="",Protocol="",FileName=FileName,FolderPath=FolderPath,SHA256=SHA256,SHA1=SHA1,MD5=MD5,ProcessCommandLine=ProcessCommandLine,InitiatingProcessFileName=InitiatingProcessFileName,InitiatingProcessCommandLine=InitiatingProcessCommandLine,InitiatingProcessAccountName=InitiatingProcessAccountName,InitiatingProcessSHA256=InitiatingProcessSHA256,RegistryKey="",RegistryValueName="",RegistryValueData="",ReportId=tostring(ReportId),ThreatName,ThreatActor,Confidence,IntelSource,SourceArticle,SourceURL,ArticlePublishedDate,RecommendedLookbackDays,RequestedLookbackDays,AvailableLookbackDays,EffectiveLookbackDays,MITRETechnique,SharedInfrastructure,ChangeStatus
)
| order by Timestamp desc
