Query name: CYBERMEDIC Elastic Stage 1 domain network dns.question.name batch 003
Description: Stage 1 lightweight IOC hit summary with endpoint, time range, hit count, source stream, and CTI provenance.
Author: CYBERMEDIC
Last updated: 2026-09-24
Schema capability: elastic-defend-ecs-2026-09-21
Schema reference: https://www.elastic.co/docs/reference/integrations/endpoint
*/
FROM logs-endpoint.events.network-* METADATA _index
| WHERE @timestamp >= NOW() - 30 days
| WHERE event.category == "network"
| WHERE dns.question.name IN ("pdfsecurtoviewothers.cfd", "pdfsecurtoviewothers.sbs", "pdfsecurtoviewsuite.sbs", "pikecac.cfd", "qrcoderuser.cfd", "selectivelife01.sbs", "sharepointer-dr.com", "sharerpoint.cam", "solarengyloanfunds.com", "stubborn-academy.icu", "voicermailsmessager.cam", "zerichoproject.org")
| EVAL MatchedIOC = TO_STRING(dns.question.name)
| STATS FirstSeen = MIN(@timestamp), LastSeen = MAX(@timestamp), HitCount = COUNT(*) BY MatchedIOC, host.name, _index
| RENAME host.name AS DeviceName, _index AS ElasticHitSource
| EVAL IOCType = "domain", MatchedField = "dns.question.name"
| EVAL ThreatName = "CSuite device-code phishing and remote-access campaign", ThreatActor = "CSuite operators"
| EVAL SourceConfidence = 88, AcceptanceScore = 88, EffectiveLookbackDays = 30
| EVAL IntelSource = "Gurucul Threat Research: https://community.gurucul.com/articles/ThreatResearch/CSuite-Targets-US-and-EU-Organizations-23-9-2026", SourceArticle = "CSuite Targets US and EU Organizations with Device-Code Phishing and Remote Access", SourceURL = "https://community.gurucul.com/articles/ThreatResearch/CSuite-Targets-US-and-EU-Organizations-23-9-2026"
| KEEP MatchedIOC, IOCType, DeviceName, FirstSeen, LastSeen, HitCount, ElasticHitSource, MatchedField, ThreatName, ThreatActor, SourceConfidence, AcceptanceScore, IntelSource, SourceArticle, SourceURL, EffectiveLookbackDays
| SORT LastSeen DESC
| LIMIT 100
/* ===== END Elastic Stage 1 domain network dns.question.name batch 003 ===== */
