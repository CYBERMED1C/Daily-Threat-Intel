union
(
DeviceNetworkEvents
| where Timestamp >= ago(30d)
| where isnotempty(RemoteIP)
| extend MatchKey=tolower(tostring(RemoteIP))
| join kind=inner hint.strategy=broadcast (IOCs | where IOCType == "ipv4" | extend IntelKey=tolower(IOC)) on $left.MatchKey == $right.IntelKey
| where Timestamp >= ago(EffectiveLookbackDays * 1d)
| project Timestamp,IOC,IOCType,MatchedField="RemoteIP",MDEHitSource="DeviceNetworkEvents",DeviceName=DeviceName,DeviceId=DeviceId,ActionType=ActionType,AccountName=InitiatingProcessAccountName,LocalIP=LocalIP,LocalPort=tostring(LocalPort),RemoteIP=RemoteIP,RemotePort=tostring(RemotePort),RemoteUrl=RemoteUrl,Protocol=Protocol,FileName="",FolderPath="",SHA256="",SHA1="",MD5="",ProcessCommandLine="",InitiatingProcessFileName=InitiatingProcessFileName,InitiatingProcessCommandLine=InitiatingProcessCommandLine,InitiatingProcessAccountName=InitiatingProcessAccountName,InitiatingProcessSHA256=InitiatingProcessSHA256,InitiatingProcessSHA1=InitiatingProcessSHA1,InitiatingProcessMD5=InitiatingProcessMD5,RegistryKey="",RegistryValueName="",RegistryValueData="",ReportId=tostring(ReportId),ThreatName,ThreatActor,Campaign,Confidence,IntelSource,SourceArticle,SourceURL,ArticlePublishedDate,RecommendedLookbackDays,RequestedLookbackDays,AvailableLookbackDays,EffectiveLookbackDays,MITRETechnique,SharedInfrastructure,ChangeStatus
),
(
DeviceNetworkEvents
| where Timestamp >= ago(30d)
| where isnotempty(RemoteUrl)
| extend MatchKey=tolower(tostring(iif(RemoteUrl startswith "http://" or RemoteUrl startswith "https://", tostring(parse_url(RemoteUrl).Host), trim_end(@"[.]$", RemoteUrl))))
| join kind=inner hint.strategy=broadcast (IOCs | where IOCType == "domain" | extend IntelKey=tolower(IOC)) on $left.MatchKey == $right.IntelKey
