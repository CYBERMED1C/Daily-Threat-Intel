/* Query name: CYBERMEDIC Daily DOMAIN IOC Hunt 1 */
/* Description: Search 30-day Elastic Defend telemetry for validated DOMAIN indicators. */
/* Author: CYBERMEDIC */
/* Last updated: 2026-09-21 */
/* Notes: Exact IOC lookup; see the daily IOC summary for intelligence context. */
FROM logs-endpoint.events.network-*
| WHERE @timestamp >= NOW() - 30 DAYS
| WHERE destination.domain IN ("airduct1.com","amalqasehselangor.com","analysis-id-lfg.info","annamaclean.com","arushigupta.life","ascendpopdownloadtoday.monster","asiana-online.com","betesebplus.com","bluemountainloan.com","boardgamepix.com","boundpopclickgetfile.monster","breadcabin.com","canflymarketing.com","chatgpt-web.vip","clickzona.net","cloudflare-check.net","connorkimble.com","daleeby.com","di-il.com","dutyfrees.digital","familyonlinestore.com","flarclod.top","gardelectricalcontracting.com","golfcoursetravel.com","golftucsonarizona.com","hanbayjewellery.com","hestiamortgages.com","id-ll.com","ilaumachque.com","interactivsbroker.com","islamjamal.com","josephtoone.com","jouncepopdownloadnow.com","jumppopdownloadsecret.monster","kawaiininjaclub.cfd","lastdayornot.top","launchingramps.com","leosafari.com","lewdstories.com","lionheadsl.com","locoaudio.com","lyxorgbs.com","maidsradar.com","medfinadvisory.com","nanakshahicoin.com","onlineprivacyprotect.com","photobyroyan.com","pigeononpinguin.top","ploutouscapitalus.com","plumber-charlotte.com")
| EVAL IOC=TO_STRING(destination.domain)
| KEEP @timestamp,host.name,process.name,destination.ip,destination.port,destination.domain,IOC
| SORT @timestamp DESC
| LIMIT 500
/* End domain hunt 1 */
/* Query name: CYBERMEDIC Daily DOMAIN IOC Hunt 2 */
