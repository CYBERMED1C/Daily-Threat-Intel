/* ===== hash IOC hunt ===== */
/*
Query name: CYBERMEDIC hash IOC hunt
Description: High-confidence Elastic Defend IOC matches with CTI provenance.
Author: CYBERMEDIC
Last updated: 2026-09-21
Schema capability: elastic-defend-ecs-2026-09-20
Schema reference: https://www.elastic.co/docs/reference/integrations/endpoint
*/
FROM logs-endpoint.events.*
| WHERE @timestamp >= NOW() - 30 days
| WHERE (file.hash.sha1 == "b6bc9e1d0b2fb96ab7c47e04cb0be477410bc1f2" OR process.hash.sha1 == "b6bc9e1d0b2fb96ab7c47e04cb0be477410bc1f2" OR dll.hash.sha1 == "b6bc9e1d0b2fb96ab7c47e04cb0be477410bc1f2") OR (file.hash.sha1 == "caf2c54e400437da717cf215181b170f65187abf" OR process.hash.sha1 == "caf2c54e400437da717cf215181b170f65187abf" OR dll.hash.sha1 == "caf2c54e400437da717cf215181b170f65187abf")
| EVAL IOC = CASE((file.hash.sha1 == "b6bc9e1d0b2fb96ab7c47e04cb0be477410bc1f2" OR process.hash.sha1 == "b6bc9e1d0b2fb96ab7c47e04cb0be477410bc1f2" OR dll.hash.sha1 == "b6bc9e1d0b2fb96ab7c47e04cb0be477410bc1f2"), "b6bc9e1d0b2fb96ab7c47e04cb0be477410bc1f2", (file.hash.sha1 == "caf2c54e400437da717cf215181b170f65187abf" OR process.hash.sha1 == "caf2c54e400437da717cf215181b170f65187abf" OR dll.hash.sha1 == "caf2c54e400437da717cf215181b170f65187abf"), "caf2c54e400437da717cf215181b170f65187abf", "")
