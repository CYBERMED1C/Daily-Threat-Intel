/* Query name: CYBERMEDIC Daily IOC Hunt */
/* Description: Search 30-day Elastic Defend telemetry for validated IOC values. */
/* Author: CYBERMEDIC */
/* Last updated: 2026-10-25 */
/* Notes: One runnable query; exact IOC filters precede newest-first results. */
FROM logs-endpoint.events.*
| WHERE @timestamp >= NOW() - 30 DAYS
| WHERE destination.domain IN ("www.archivetj.com") OR destination.ip IN ("199.91.221.39","45.115.26.26","5.175.189.76","69.48.229.143") OR file.hash.md5 IN ("af8a983b9ada07eae1259bf2953abd40") OR file.hash.sha256 IN ("0c5486f06620e26e316f4b33f318b0d646d5e1133789331aa2fed012360d1486","e2529d4afa39ae4db2eb05d5176317c906289abf09660c75bdeec43e54c55aa3")
| KEEP @timestamp,host.name,process.name,file.name,file.path,destination.ip,destination.port,destination.domain,file.hash.md5,file.hash.sha1,file.hash.sha256
| SORT @timestamp DESC
| LIMIT 500
