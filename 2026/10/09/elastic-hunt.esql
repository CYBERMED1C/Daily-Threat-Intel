/* Query name: CYBERMEDIC Daily IOC Hunt */
/* Description: Search 30-day Elastic Defend telemetry for validated IOC values. */
/* Author: CYBERMEDIC */
/* Last updated: 2026-10-09 */
/* Notes: One runnable query; exact IOC filters precede newest-first results. */
FROM logs-endpoint.events.*
| WHERE @timestamp >= NOW() - 30 DAYS
| WHERE destination.domain IN ("98aiblog.com","98aicai.com","98aicode.com","agrafund.qpon","c0cc.cc","linkedinns.net","lo-ja-ma-galu-store.com","outlook3650.com","www.ads-meetta.icu","youtubecard.com") OR destination.ip IN ("156.247.40.74") OR file.hash.sha256 IN ("50a4d7e4a0bf740b125e44b4260c1afe0e73690890799e85960f39bdc27d6665","b077215af833ac80e92a57f8ab2613217e87f7f7aa9ed16ce9497f08de54d5f0","b426e063f6e71de0d8c7bd6b1ed9c342e3aed4e16ff9d0b50154c67b899f8541")
| KEEP @timestamp,host.name,process.name,file.name,file.path,destination.ip,destination.port,destination.domain,file.hash.md5,file.hash.sha1,file.hash.sha256
| SORT @timestamp DESC
| LIMIT 500
