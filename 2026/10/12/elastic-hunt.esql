/* Query name: CYBERMEDIC Daily IOC Hunt */
/* Description: Search 30-day Elastic Defend telemetry for validated IOC values. */
/* Author: CYBERMEDIC */
/* Last updated: 2026-10-12 */
/* Notes: One runnable query; exact IOC filters precede newest-first results. */
FROM logs-endpoint.events.*
| WHERE @timestamp >= NOW() - 30 DAYS
| WHERE destination.domain IN ("auspost.adqwr.com","securepaypalcard.com","www.roblox.com.mu") OR destination.ip IN ("46.38.138.50") OR file.hash.md5 IN ("dbc520ea1518748fec9fcfcf29755c30","eec5c6c219535fba3a0492ea8118b397") OR file.hash.sha256 IN ("51ef4a7863a921980f5c3f3522449faaf851c5a6c3f1c12e8cf186ce593f6753","5ba16e04e5b0fbe173185b17b9a807895a6bdea7717db6b0cbec4ccea9907f51")
| KEEP @timestamp,host.name,process.name,file.name,file.path,destination.ip,destination.port,destination.domain,file.hash.md5,file.hash.sha1,file.hash.sha256
| SORT @timestamp DESC
| LIMIT 500
