/* Query name: CYBERMEDIC Daily IOC Hunt */
/* Description: Search 30-day Elastic Defend telemetry for validated IOC values. */
/* Author: CYBERMEDIC */
/* Last updated: 2026-10-15 */
/* Notes: One runnable query; exact IOC filters precede newest-first results. */
FROM logs-endpoint.events.*
| WHERE @timestamp >= NOW() - 30 DAYS
| WHERE destination.domain IN ("abubra.jo3.org") OR destination.ip IN ("23.240.77.233","42.6.101.155","45.171.124.23","45.32.41.202") OR file.hash.sha256 IN ("6b68a1f5df0a2e64d8d5092dacf355a35bbab4e7d5d6c193234a05bc5037dcbc","829b1cd270b30565739a478441833f49f10a49bd06f0d18cc96c8ae4a0431f11","b9fb0b27ddd59b58d3ae53c7227298a3e0de1e6f868b9429ae21533bb9cd1e70","bd064244dad748cf2a44074bee56f5bfab4a2b18ee944b75d1b3febd4c1fe02a","d744542a42c4720ad36f1127ee5af5f013f23ae5822cdaae2ff03345f2839594")
| KEEP @timestamp,host.name,process.name,file.name,file.path,destination.ip,destination.port,destination.domain,file.hash.md5,file.hash.sha1,file.hash.sha256
| SORT @timestamp DESC
| LIMIT 500
