/* Query name: CYBERMEDIC Daily IOC Hunt */
/* Description: Search 30-day Elastic Defend telemetry for validated IOC values. */
/* Author: CYBERMEDIC */
/* Last updated: 2026-10-16 */
/* Notes: One runnable query; exact IOC filters precede newest-first results. */
FROM logs-endpoint.events.*
| WHERE @timestamp >= NOW() - 30 DAYS
| WHERE destination.domain IN ("happyslot88pg.co") OR destination.ip IN ("104.194.158.65","153.117.15.107","220.191.125.250") OR file.hash.sha256 IN ("27d799ceadb570bfca890d4c2572314afe57eecf14083d30409da15afdfc4704","2bf7992e6260c1a98c709fa98ec766fb9f27692f338b30b43ac821b824fd849e","9e45830171eb607cf2c0fc80f5cc9cc3db39bb937032136990383a595f6f151e","b08bff811d20fb95abbb8a09175f33a749c1dff6967b86e583ba5f5ee08872e5","d73186cea6cf2cf3d48c09139a9d15521365aab675787b4e7a6f81767331c9fd","ebb2f6d9ee6731d87d430b7c9114d4fa02ffb5adba565da3ffda7cca0afb2353")
| KEEP @timestamp,host.name,process.name,file.name,file.path,destination.ip,destination.port,destination.domain,file.hash.md5,file.hash.sha1,file.hash.sha256
| SORT @timestamp DESC
| LIMIT 500
