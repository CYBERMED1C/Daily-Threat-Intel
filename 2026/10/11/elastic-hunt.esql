/* Query name: CYBERMEDIC Daily IOC Hunt */
/* Description: Search 30-day Elastic Defend telemetry for validated IOC values. */
/* Author: CYBERMEDIC */
/* Last updated: 2026-10-11 */
/* Notes: One runnable query; exact IOC filters precede newest-first results. */
FROM logs-endpoint.events.*
| WHERE @timestamp >= NOW() - 30 DAYS
| WHERE destination.domain IN ("claude-desk-code.com","cli-desktop.com","fairpoint29.com","fine-byte2.com","lake-90.com","magaz-ine-lu-iza.com","rapid-craft567.com","trfnf2.go.watchs.vip","turbowave45.com") OR destination.ip IN ("101.35.247.212","146.190.106.155","20.111.19.203") OR file.hash.sha256 IN ("10c32c43ffe6a500840cc577c56b8107efb9c23c5a9c7c2cbf00a84894328ae6","81da78f52b2a92eb67e5490d8b296be00f3a253c71850b267138949ce2d50f73")
| KEEP @timestamp,host.name,process.name,file.name,file.path,destination.ip,destination.port,destination.domain,file.hash.md5,file.hash.sha1,file.hash.sha256
| SORT @timestamp DESC
| LIMIT 500
