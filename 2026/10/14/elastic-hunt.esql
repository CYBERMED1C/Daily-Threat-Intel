/* Query name: CYBERMEDIC Daily IOC Hunt */
/* Description: Search 30-day Elastic Defend telemetry for validated IOC values. */
/* Author: CYBERMEDIC */
/* Last updated: 2026-10-14 */
/* Notes: One runnable query; exact IOC filters precede newest-first results. */
FROM logs-endpoint.events.*
| WHERE @timestamp >= NOW() - 30 DAYS
| WHERE destination.domain IN ("blog-tecnet-microsoft.serveftp.com","helptrezriosdtart.gitbook.io","m-faceboooks.com.vn") OR destination.ip IN ("120.84.212.113","37.18.27.27","45.139.104.222","46.246.12.8") OR file.hash.sha256 IN ("604802b26921351110ef475d7708d8e7031b551192f72272effc7bc66bf3abbd","b9079c2c87348a8b598496606cb6a6d2f9df53230f4420e8688a3751285b2144","dff3461b7b0b793c6dc62a63ffb6560c3babd7ca0b8d479ee2f7cbd4486c9d85")
| KEEP @timestamp,host.name,process.name,file.name,file.path,destination.ip,destination.port,destination.domain,file.hash.md5,file.hash.sha1,file.hash.sha256
| SORT @timestamp DESC
| LIMIT 500
